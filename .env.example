# MongoDB (Railway)
MONGODB_URI="mongodb://user:pass@host:port"
MONGODB_DB="fts"

# Auth.js
AUTH_SECRET="generate with: npx auth secret"
AUTH_URL="http://localhost:3000"

# One-time admin seed (used only by `npm run seed:admin`)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"

# AWS S3 (blog images)
AWS_REGION="eu-west-2"
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
S3_BUCKET="fts-marketing-website-blogs-images"
# Optional CDN/custom-domain base; defaults to https://<bucket>.s3.<region>.amazonaws.com
S3_PUBLIC_BASE_URL=""
